    choice2: 2
    choice3: sin\u03B8cos\u03B8
    choice4: tan\u03B8
    correctAnswerIndex: 1
    explanation: "\u4E09\u89D2\u95A2\u6570\u306E\u57FA\u672C\u516C\u5F0F\u3067\u3059\u3002"
  - questionText: "2\xB3 = ?"
