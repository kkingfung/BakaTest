    choice2: "\u751F\u6210\u7269"
    choice3: "\u963B\u5BB3\u5264"
    choice4: "\u6D3B\u6027\u5316\u5264"
    correctAnswerIndex: 3
    explanation: "\u963B\u5BB3\u5264\uFF08inhibitor\uFF09\u304C\u9175\u7D20\u306E\u6D3B\u6027\u3092\u4F4E\u4E0B\u3055\u305B\u307E\u3059\u3002"
  - questionText: "What is the speed of sound in air at 20\xB0C?"
    choice0: "340 m/s"
    choice1: "3000 m/s"
    choice2: "3 \xD7 10\u2078 m/s"
    choice3: "1500 m/s"
    choice4: "100 m/s"
    correctAnswerIndex: 0
    explanation: "\u7A7A\u6C17\u4E2D\u306E\u97F3\u901F\u306F\u7D04340 m/s\uFF0820\u2103\uFF09\u3067\u3059\u3002"
  - questionText: "\u539F\u5B50\u306E\u8CEA\u91CF\u6570\u3068\u306F?"
    choice0: "\u96FB\u5B50\u6570"
    choice1: "\u967D\u5B50\u6570"
    choice2: "\u4E2D\u6027\u5B50\u6570"
