  - questionText: "\u30EB\u30FB\u30B7\u30E3\u30C8\u30EA\u30A8\u306E\u539F\u7406\u3068\u306F?"
    choice0: "\u5727\u529B\u3092\u5927\u304D\u304F\u3059\u308B\u3068\u5E73\u8861\u304C\u79FB\u52D5\u3059\u308B"
    choice1: "\u6E29\u5EA6\u3092\u4E0A\u3052\u308B\u3068\u5E73\u8861\u304C\u79FB\u52D5\u3059\u308B"
    choice2: "\u5916\u90E8\u304B\u3089\u306E\u5727\u529B\u5909\u5316\u306B\u5BFE\u3057\u3066\u5E73\u8861\u304C\u79FB\u52D5\u3059\u308B"
    choice3: "\u89E6\u5A92\u3092\u52A0\u3048\u308B\u3068\u53CD\u5FDC\u901F\u5EA6\u304C\u4E0A\u304C\u308B"
