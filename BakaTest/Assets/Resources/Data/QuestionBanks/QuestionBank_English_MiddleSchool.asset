    choice2: because
    choice3: if
    choice4: when
    correctAnswerIndex: 1
    explanation: "although = ~\u3060\u3051\u308C\u3069\u3082"
  - questionText: "There ___ many books on the desk. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
