    choice3: when
    choice4: although
    correctAnswerIndex: 1
    explanation: "because = ~\u306A\u306E\u3067"
  - questionText: "I have been ___ for two hours. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
    choice0: study
