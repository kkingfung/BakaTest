  subject: 2
  difficulty: 1
  questions:
  - questionText: "\u300C\u5F7C\u5973\u306F\u82F1\u8A9E\u3092\u52C9\u5F37\u3057\u3066\u3044\u308B\u300D\u306E\u82F1\u8A33\u306F?"
    choice0: She study English
    choice1: She studied English
    choice2: She is studying English
    choice3: She studies English
    choice4: She will study English
    correctAnswerIndex: 2
    explanation: "\u73FE\u5728\u9032\u884C\u5F62: is studying"
  - questionText: "\"Beautiful\"\u306E\u6BD4\u8F03\u7D1A\u306F?"
    choice0: beautifuler
    choice1: more beautiful
    choice2: most beautiful
    choice3: beautifully
    choice4: beautifulest
    correctAnswerIndex: 1
    explanation: "\u9577\u3044\u5F62\u5BB9\u8A5E: more beautiful"
  - questionText: "She ___ to school every day. \u7A7A\u6B04\u306B\u5165\u308B\u52D5\u8A5E\u306F?"
    choice0: go
    choice1: goes
    choice2: going
    choice3: went
    choice4: gone
    correctAnswerIndex: 1
    explanation: "\u4E09\u4EBA\u79F0\u5358\u6570\u73FE\u5728\u5F62: She goes"
  - questionText: "I have ___ this book. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
    choice0: read
    choice1: reading
    choice2: reads
    choice3: readed
    choice4: to read
    correctAnswerIndex: 0
    explanation: "\u73FE\u5728\u5B8C\u4E86\u5F62: have + \u904E\u53BB\u5206\u8A5E"
  - questionText: "\u300C\u3082\u3057~\u306A\u3089\u300D\u3092\u8868\u3059\u63A5\u7D9A\u8A5E\u306F?"
    choice0: because
    choice1: if
    choice2: when
    choice3: but
    choice4: and
    correctAnswerIndex: 1
    explanation: "if = \u3082\u3057~\u306A\u3089"
  - questionText: "He is ___ than me. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
    choice0: tall
    choice1: taller
    choice2: tallest
    choice3: more tall
    choice4: most tall
    correctAnswerIndex: 1
    explanation: "\u6BD4\u8F03\u7D1A: -er \u3092\u3064\u3051\u308B"
  - questionText: "\u300C\u5F7C\u306F\u6628\u65E5\u516C\u5712\u306B\u884C\u3063\u305F\u300D\u306E\u82F1\u8A33\u306F?"
    choice0: He go to the park yesterday
    choice1: He goes to the park yesterday
    choice2: He went to the park yesterday
    choice3: He is going to the park yesterday
    choice4: He will go to the park yesterday
    correctAnswerIndex: 2
    explanation: "\u904E\u53BB\u5F62: went"
  - questionText: "I ___ to Tokyo next week. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
    choice0: go
    choice1: went
    choice2: going
    choice3: will go
    choice4: gone
    correctAnswerIndex: 3
    explanation: "\u672A\u6765\u5F62: will go"
  - questionText: "\u300C~\u3059\u308B\u3053\u3068\u300D\u3092\u8868\u3059\u52D5\u540D\u8A5E\u306F?"
    choice0: to do
    choice1: doing
    choice2: to doing
    choice3: do
    choice4: did
    correctAnswerIndex: 1
    explanation: "\u52D5\u540D\u8A5E: -ing \u5F62"
  - questionText: "This is the ___ book I've ever read. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
    choice0: good
    choice1: better
    choice2: best
    choice3: more good
    choice4: most good
    correctAnswerIndex: 2
    explanation: "\u6700\u4E0A\u7D1A: the best"
  - questionText: "She can ___ English well. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
