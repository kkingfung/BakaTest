    choice2: was
    choice3: be
    choice4: been
    correctAnswerIndex: 1
    explanation: "There are + \u8907\u6570\u540D\u8A5E"
  - questionText: "I enjoy ___ music. \u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
