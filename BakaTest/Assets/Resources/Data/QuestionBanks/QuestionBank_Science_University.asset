    choice1: 1
    choice2: 1/2
    choice3: 2
    choice4: -1
    correctAnswerIndex: 2
    explanation: "\u96FB\u5B50\u306F\u30B9\u30D4\u30F31/2\u306E\u30D5\u30A7\u30EB\u30DF\u7C92\u5B50\u3067\u3059\u3002"
  - questionText: "\u30DF\u30C8\u30B3\u30F3\u30C9\u30EA\u30A2\u306E\u4E3B\u306A\u6A5F\u80FD\u306F?"
