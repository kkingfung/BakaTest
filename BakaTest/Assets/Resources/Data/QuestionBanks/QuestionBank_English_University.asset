  questions:
  - questionText: "\u5206\u8A5E\u69CB\u6587 \"Having finished the work, he went home\"
      \u306E\u610F\u5473\u306F?"
    choice0: "\u4ED5\u4E8B\u3092\u7D42\u3048\u3066\u3044\u308B\u9593\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    choice1: "\u4ED5\u4E8B\u3092\u7D42\u3048\u305F\u5F8C\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    choice2: "\u4ED5\u4E8B\u3092\u7D42\u3048\u308B\u524D\u306B\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    choice3: "\u4ED5\u4E8B\u3092\u7D42\u3048\u306A\u304C\u3089\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    choice4: "\u4ED5\u4E8B\u3092\u7D42\u3048\u308B\u305F\u3081\u306B\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    correctAnswerIndex: 1
    explanation: "\u5B8C\u4E86\u5206\u8A5E\u69CB\u6587: ~\u3057\u305F\u5F8C"
  - questionText: "\"Albeit\"\u306E\u7528\u6CD5\u3068\u3057\u3066\u6B63\u3057\u3044\u306E\u306F?"
    choice0: "\u63A5\u7D9A\u8A5E\uFF08~\u3060\u3051\u308C\u3069\u3082\uFF09"
    choice1: "\u540D\u8A5E\uFF08\u8A3C\u62E0\uFF09"
    choice2: "\u52D5\u8A5E\uFF08\u4E3B\u5F35\u3059\u308B\uFF09"
    choice3: "\u5F62\u5BB9\u8A5E\uFF08\u660E\u767D\u306A\uFF09"
    choice4: "\u526F\u8A5E\uFF08\u5E38\u306B\uFF09"
    correctAnswerIndex: 0
    explanation: "albeit = although\uFF08~\u3060\u3051\u308C\u3069\u3082\uFF09"
  - questionText: "\"Serendipity\"\u306E\u610F\u5473\u3068\u3057\u3066\u6700\u3082\u9069\u5207\u306A\u306E\u306F?"
    choice0: "\u60B2\u5287"
    choice1: "\u601D\u3044\u304C\u3051\u306A\u3044\u5E78\u904B\u306A\u767A\u898B"
    choice2: "\u8A08\u753B\u7684\u306A\u6210\u529F"
    choice3: "\u5FC5\u7136\u7684\u306A\u7D50\u679C"
    choice4: "\u4E88\u6E2C\u53EF\u80FD\u306A\u5C55\u958B"
    correctAnswerIndex: 1
    explanation: "serendipity = \u5076\u7136\u306E\u5E78\u904B\u306A\u767A\u898B"
  - questionText: "\u5206\u8A5E\u69CB\u6587 \"Having finished the work, he went home\"
