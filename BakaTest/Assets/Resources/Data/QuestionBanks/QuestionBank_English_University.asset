    choice1: "\u4ED5\u4E8B\u3092\u7D42\u3048\u305F\u5F8C\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    choice2: "\u4ED5\u4E8B\u3092\u7D42\u3048\u308B\u524D\u306B\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    choice3: "\u4ED5\u4E8B\u3092\u7D42\u3048\u306A\u304C\u3089\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
    choice4: "\u4ED5\u4E8B\u3092\u7D42\u3048\u308B\u305F\u3081\u306B\u3001\u5F7C\u306F\u5BB6\u306B\u5E30\u3063\u305F"
