    choice3: "\u30A2\u30D5\u30EA\u30AB\u306E\u89E3\u653E"
    choice4: "\u4E2D\u6771\u306E\u5B89\u5B9A"
    correctAnswerIndex: 0
    explanation: "\u30DE\u30FC\u30B7\u30E3\u30EB\u30FB\u30D7\u30E9\u30F3\u306F\u897F\u6B27\u306E\u7D4C\u6E08\u5FA9\u8208\u8A08\u753B\u3067\u3059\u3002"
  - questionText: "NATO\uFF08\u5317\u5927\u897F\u6D0B\u6761\u7D04\u6A5F\u69CB\uFF09\u304C\u7D50\u6210\u3055\u308C\u305F\u306E\u306F\u4F55\u5E74?"
