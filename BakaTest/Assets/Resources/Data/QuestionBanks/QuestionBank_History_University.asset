    choice2: "NATO\u7D50\u6210"
    choice3: "\u30EF\u30EB\u30B7\u30E3\u30EF\u6761\u7D04\u6A5F\u69CB"
    choice4: "\u56FD\u9023\u8A2D\u7ACB"
    correctAnswerIndex: 0
    explanation: "\u30C8\u30EB\u30FC\u30DE\u30F3\u30FB\u30C9\u30AF\u30C8\u30EA\u30F3\u306F\u5171\u7523\u4E3B\u7FA9\u306E\u5C01\u3058\u8FBC\u3081\u653F\u7B56\u3067\u3059\u3002"
  - questionText: "\u30DE\u30FC\u30B7\u30E3\u30EB\u30FB\u30D7\u30E9\u30F3\u306E\u76EE\u7684\u306F?"
    choice0: "\u897F\u30E8\u30FC\u30ED\u30C3\u30D1\u306E\u7D4C\u6E08\u5FA9\u8208"
