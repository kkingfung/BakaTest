  questions:
  - questionText: "\u30A6\u30A7\u30B9\u30C8\u30D5\u30A1\u30EA\u30A2\u6761\u7D04\uFF081648\u5E74\uFF09\u306E\u610F\u7FA9\u306F?"
    choice0: "\u30AB\u30C8\u30EA\u30C3\u30AF\u306E\u52DD\u5229"
    choice1: "\u30D7\u30ED\u30C6\u30B9\u30BF\u30F3\u30C8\u306E\u52DD\u5229"
    choice2: "\u4E3B\u6A29\u56FD\u5BB6\u4F53\u5236\u306E\u78BA\u7ACB"
    choice3: "\u795E\u8056\u30ED\u30FC\u30DE\u5E1D\u56FD\u306E\u5FA9\u6D3B"
    choice4: "\u6559\u7687\u6A29\u306E\u5F37\u5316"
    correctAnswerIndex: 2
    explanation: "\u30A6\u30A7\u30B9\u30C8\u30D5\u30A1\u30EA\u30A2\u6761\u7D04\u306F\u4E3B\u6A29\u56FD\u5BB6\u4F53\u5236\u3092\u78BA\u7ACB\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u5553\u8499\u601D\u60F3\u306E\u4E2D\u5FC3\u601D\u60F3\u306F?"
    choice0: "\u795E\u6A29\u8AAC"
    choice1: "\u7406\u6027\u3068\u81EA\u7136\u6CD5"
    choice2: "\u5C01\u5EFA\u5236\u306E\u7DAD\u6301"
    choice3: "\u7D76\u5BFE\u738B\u653F\u306E\u5F37\u5316"
    choice4: "\u8CB4\u65CF\u306E\u7279\u6A29\u64E1\u8B77"
    correctAnswerIndex: 1
    explanation: "\u5553\u8499\u601D\u60F3\u306F\u7406\u6027\u3068\u81EA\u7136\u6CD5\u3092\u91CD\u8996\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u30E2\u30F3\u30C6\u30B9\u30AD\u30E5\u30FC\u306E\u300C\u6CD5\u306E\u7CBE\u795E\u300D\u3067\u63D0\u5531\u3055\u308C\u305F\u539F\u7406\u306F?"
    choice0: "\u4EBA\u6C11\u4E3B\u6A29"
    choice1: "\u793E\u4F1A\u5951\u7D04"
    choice2: "\u4E09\u6A29\u5206\u7ACB"
    choice3: "\u81EA\u7136\u72B6\u614B"
    choice4: "\u4E00\u822C\u610F\u5FD7"
    correctAnswerIndex: 2
    explanation: "\u30E2\u30F3\u30C6\u30B9\u30AD\u30E5\u30FC\u306F\u4E09\u6A29\u5206\u7ACB\u3092\u63D0\u5531\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u30EB\u30BD\u30FC\u306E\u300C\u793E\u4F1A\u5951\u7D04\u8AD6\u300D\u3067\u4E2D\u5FC3\u7684\u306A\u6982\u5FF5\u306F?"
    choice0: "\u4E09\u6A29\u5206\u7ACB"
    choice1: "\u4E00\u822C\u610F\u5FD7"
    choice2: "\u81EA\u7136\u6CD5"
    choice3: "\u795E\u6A29\u8AAC"
    choice4: "\u529F\u5229\u4E3B\u7FA9"
    correctAnswerIndex: 1
    explanation: "\u30EB\u30BD\u30FC\u306F\u4E00\u822C\u610F\u5FD7\u3092\u4E2D\u5FC3\u6982\u5FF5\u3068\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u30A2\u30C0\u30E0\u30FB\u30B9\u30DF\u30B9\u304C\u300C\u8AF8\u56FD\u6C11\u306E\u5BCC\u300D\u3067\u63D0\u5531\u3057\u305F\u6982\u5FF5\u306F?"
    choice0: "\u91CD\u5546\u4E3B\u7FA9"
    choice1: "\u81EA\u7531\u653E\u4EFB\uFF08\u30EC\u30C3\u30BB\u30FB\u30D5\u30A7\u30FC\u30EB\uFF09"
    choice2: "\u4FDD\u8B77\u8CBF\u6613"
    choice3: "\u793E\u4F1A\u4E3B\u7FA9"
    choice4: "\u5E1D\u56FD\u4E3B\u7FA9"
    correctAnswerIndex: 1
    explanation: "\u30A2\u30C0\u30E0\u30FB\u30B9\u30DF\u30B9\u306F\u81EA\u7531\u653E\u4EFB\u3092\u63D0\u5531\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u30DE\u30EB\u30AF\u30B9\u3068\u30A8\u30F3\u30B2\u30EB\u30B9\u304C\u8457\u3057\u305F\u8457\u4F5C\u306F?"
    choice0: "\u300C\u8CC7\u672C\u8AD6\u300D"
    choice1: "\u300C\u5171\u7523\u515A\u5BA3\u8A00\u300D"
    choice2: "\u300C\u7A7A\u60F3\u7684\u793E\u4F1A\u4E3B\u7FA9\u304B\u3089\u79D1\u5B66\u7684\u793E\u4F1A\u4E3B\u7FA9\u3078\u300D"
    choice3: "\u4E0A\u8A18\u5168\u3066"
    choice4: "\u300C\u8AF8\u56FD\u6C11\u306E\u5BCC\u300D"
    correctAnswerIndex: 3
    explanation: "\u30DE\u30EB\u30AF\u30B9\u3068\u30A8\u30F3\u30B2\u30EB\u30B9\u306F\u3053\u308C\u3089\u5168\u3066\u3092\u8457\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u30D3\u30B9\u30DE\u30EB\u30AF\u306E\u5916\u4EA4\u653F\u7B56\u306E\u7279\u5FB4\u306F?"
    choice0: "\u30D1\u30F3\u30FB\u30B2\u30EB\u30DE\u30F3\u4E3B\u7FA9"
    choice1: "\u30D5\u30E9\u30F3\u30B9\u5B64\u7ACB\u653F\u7B56"
    choice2: "\u30D0\u30E9\u30F3\u30B9\u30FB\u30AA\u30D6\u30FB\u30D1\u30EF\u30FC"
    choice3: "\u4E0A\u8A18\u5168\u3066"
    choice4: "\u82F1\u72EC\u540C\u76DF"
    correctAnswerIndex: 3
    explanation: "\u30D3\u30B9\u30DE\u30EB\u30AF\u306F\u30D1\u30F3\u30FB\u30B2\u30EB\u30DE\u30F3\u4E3B\u7FA9\u3001\u30D5\u30E9\u30F3\u30B9\u5B64\u7ACB\u3001\u30D0\u30E9\u30F3\u30B9\u653F\u7B56\u3092\u63A1\u308A\u307E\u3057\u305F\u3002"
  - questionText: "\u5E1D\u56FD\u4E3B\u7FA9\u6642\u4EE3\u306E\u300C\u30A2\u30D5\u30EA\u30AB\u5206\u5272\u300D\u3092\u6C7A\u3081\u305F\u4F1A\u8B70\u306F?"
    choice0: "\u30A6\u30A3\u30FC\u30F3\u4F1A\u8B70"
    choice1: "\u30D9\u30EB\u30EA\u30F3\u4F1A\u8B70"
    choice2: "\u30D1\u30EA\u4F1A\u8B70"
    choice3: "\u30ED\u30F3\u30C9\u30F3\u4F1A\u8B70"
    choice4: "\u30F4\u30A7\u30EB\u30B5\u30A4\u30E6\u4F1A\u8B70"
    correctAnswerIndex: 1
    explanation: "1884-1885\u5E74\u306E\u30D9\u30EB\u30EA\u30F3\u4F1A\u8B70\u3067\u30A2\u30D5\u30EA\u30AB\u5206\u5272\u304C\u6C7A\u3081\u3089\u308C\u307E\u3057\u305F\u3002"
  - questionText: "\u30A4\u30F3\u30C9\u306E\u72EC\u7ACB\u904B\u52D5\u3067\u4E2D\u5FC3\u7684\u5F79\u5272\u3092\u679C\u305F\u3057\u305F\u4EBA\u7269\u306F?"
    choice0: "\u30AC\u30F3\u30C7\u30A3\u30FC"
    choice1: "\u30CD\u30EB\u30FC"
    choice2: "\u30B8\u30F3\u30CA\u30FC"
    choice3: "\u4E0A\u8A18\u5168\u3066"
    choice4: "\u30BF\u30B4\u30FC\u30EB"
    correctAnswerIndex: 3
    explanation: "\u30AC\u30F3\u30C7\u30A3\u30FC\u3001\u30CD\u30EB\u30FC\u3001\u30B8\u30F3\u30CA\u30FC\u5168\u54E1\u304C\u4E2D\u5FC3\u4EBA\u7269\u3067\u3059\u3002"
  - questionText: "\u4E94\u30FB\u56DB\u904B\u52D5\uFF081919\u5E74\uFF09\u306E\u304D\u3063\u304B\u3051\u306F?"
    choice0: "\u30F4\u30A7\u30EB\u30B5\u30A4\u30E6\u6761\u7D04\u3067\u306E\u5C71\u6771\u7701\u306E\u65E5\u672C\u3078\u306E\u8B72\u6E21"
    choice1: "\u8F9B\u4EA5\u9769\u547D"
    choice2: "\u6E80\u5DDE\u4E8B\u5909"
    choice3: "\u76E7\u6E9D\u6A4B\u4E8B\u4EF6"
    choice4: "\u897F\u5B89\u4E8B\u4EF6"
    correctAnswerIndex: 0
    explanation: "\u30F4\u30A7\u30EB\u30B5\u30A4\u30E6\u6761\u7D04\u3067\u306E\u4E0D\u5E73\u7B49\u306A\u6271\u3044\u304C\u304D\u3063\u304B\u3051\u3067\u3059\u3002"
  - questionText: "\u30BD\u30D3\u30A8\u30C8\u9023\u90A6\u3067\u30B9\u30BF\u30FC\u30EA\u30F3\u304C\u91C7\u7528\u3057\u305F\u7D4C\u6E08\u653F\u7B56\u306F?"
    choice0: "\u30CD\u30C3\u30D7"
    choice1: "\u4E94\u30F6\u5E74\u8A08\u753B"
    choice2: "\u30B3\u30EB\u30DB\u30FC\u30BA"
    choice3: "\u30DA\u30EC\u30B9\u30C8\u30ED\u30A4\u30AB"
    choice4: "\u30B0\u30E9\u30B9\u30CE\u30B9\u30C1"
    correctAnswerIndex: 1
    explanation: "\u30B9\u30BF\u30FC\u30EA\u30F3\u306F\u4E94\u30F6\u5E74\u8A08\u753B\u3092\u63A8\u9032\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u30CB\u30E5\u30FC\u30C7\u30A3\u30FC\u30EB\u653F\u7B56\u306E\u7279\u5FB4\u3067\u306A\u3044\u306E\u306F?"
    choice0: "\u516C\u5171\u4E8B\u696D"
    choice1: "\u793E\u4F1A\u4FDD\u969C\u5236\u5EA6"
    choice2: "\u52B4\u50CD\u7D44\u5408\u306E\u627F\u8A8D"
    choice3: "\u81EA\u7531\u653E\u4EFB\u653F\u7B56"
    choice4: "TVA\uFF08\u30C6\u30CD\u30B7\u30FC\u5DDD\u6D41\u57DF\u958B\u767A\u516C\u793E\uFF09"
    correctAnswerIndex: 3
    explanation: "\u30CB\u30E5\u30FC\u30C7\u30A3\u30FC\u30EB\u306F\u653F\u5E9C\u4ECB\u5165\u653F\u7B56\u3067\u3001\u81EA\u7531\u653E\u4EFB\u3068\u306F\u9006\u3067\u3059\u3002"
  - questionText: "\u30D5\u30A1\u30B7\u30BA\u30E0\u306E\u7279\u5FB4\u3067\u306A\u3044\u306E\u306F?"
    choice0: "\u5168\u4F53\u4E3B\u7FA9"
    choice1: "\u6C11\u65CF\u4E3B\u7FA9"
    choice2: "\u7D71\u5236\u7D4C\u6E08"
    choice3: "\u81EA\u7531\u4E3B\u7FA9"
    choice4: "\u4E00\u515A\u72EC\u88C1"
    correctAnswerIndex: 3
    explanation: "\u30D5\u30A1\u30B7\u30BA\u30E0\u306F\u81EA\u7531\u4E3B\u7FA9\u3092\u5426\u5B9A\u3057\u307E\u3059\u3002"
  - questionText: "\u7B2C\u4E8C\u6B21\u4E16\u754C\u5927\u6226\u4E2D\u306E\u300C\u5927\u897F\u6D0B\u61B2\u7AE0\u300D\u306E\u610F\u7FA9\u306F?"
    choice0: "\u6226\u5F8C\u79E9\u5E8F\u306E\u539F\u5247"
