    choice3: "\u30D5\u30E9\u30F3\u30B9"
    choice4: "\u4E2D\u56FD"
    correctAnswerIndex: 3
    explanation: "\u30DD\u30C4\u30C0\u30E0\u4F1A\u8AC7\u306E\u53C2\u52A0\u56FD\u306F\u7C73\u82F1\u30BD\u306E\u4E09\u56FD\u3067\u3059\u3002"
  - questionText: "\u30C8\u30EB\u30FC\u30DE\u30F3\u30FB\u30C9\u30AF\u30C8\u30EA\u30F3\u306E\u5185\u5BB9\u306F?"
    choice0: "\u5171\u7523\u4E3B\u7FA9\u5C01\u3058\u8FBC\u3081"
