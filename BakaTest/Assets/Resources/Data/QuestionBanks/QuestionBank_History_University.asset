    choice2: "\u539F\u7206\u4F7F\u7528\u306E\u6C7A\u5B9A"
    choice3: "\u30BD\u9023\u306E\u53C2\u6226"
    choice4: "\u30A4\u30BF\u30EA\u30A2\u306E\u964D\u4F0F"
    correctAnswerIndex: 0
    explanation: "\u5927\u897F\u6D0B\u61B2\u7AE0\u306F\u6226\u5F8C\u4E16\u754C\u306E\u539F\u5247\u3092\u793A\u3057\u307E\u3057\u305F\u3002"
  - questionText: "\u30DD\u30C4\u30C0\u30E0\u4F1A\u8AC7\uFF081945\u5E74\uFF09\u306E\u53C2\u52A0\u56FD\u3067\u306A\u3044\u306E\u306F?"
    choice0: "\u30A2\u30E1\u30EA\u30AB"
