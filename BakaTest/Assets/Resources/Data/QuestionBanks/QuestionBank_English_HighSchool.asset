  questions:
  - questionText: "The book ___ by many people. \u53D7\u52D5\u614B\u306E\u7A7A\u6B04\u306B\u5165\u308B\u306E\u306F?"
    choice0: read
    choice1: reads
    choice2: is read
    choice3: reading
    choice4: was reading
