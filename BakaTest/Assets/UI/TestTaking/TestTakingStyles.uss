/* Test Taking Screen Styles */

/* Header Styles */
.header {
    padding: 20px;
    background-color: rgba(30, 35, 45, 0.9);
    border-bottom-width: 3px;
    border-color: rgba(100, 150, 255, 0.5);
}

.header-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.subject-label {
    font-size: 24px;
    color: rgb(150, 200, 255);
    -unity-font-style: bold;
}

.timer-label {
    font-size: 32px;
    color: rgb(100, 255, 150);
    -unity-font-style: bold;
    min-width: 120px;
    -unity-text-align: middle-right;
}

.timer-label.warning {
    color: rgb(255, 200, 100);
}

.timer-label.danger {
    color: rgb(255, 100, 100);
}

.header-bottom {
    flex-direction: row;
    align-items: center;
}

.question-number-label {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
    margin-right: 20px;
    min-width: 120px;
}

.progress-bar {
    flex-grow: 1;
    height: 12px;
    background-color: rgba(30, 35, 45, 0.8);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(100, 150, 255, 0.3);
    overflow: hidden;
}

.progress-fill {
    width: 10%;
    height: 100%;
    background-color: rgb(100, 150, 255);
    border-radius: 6px;
    transition-duration: 0.3s;
    transition-property: width;
}

/* Content Area */
.content-area {
    flex-grow: 1;
    padding: 30px;
    justify-content: flex-start;
}

/* Question Panel */
.question-panel {
    min-height: 150px;
    padding: 30px;
    background-color: rgba(50, 60, 80, 0.4);
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
    margin-bottom: 30px;
    justify-content: center;
}

.question-text {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    white-space: normal;
}

/* Answers Container */
.answers-container {
    flex-grow: 1;
}

.answer-button {
    flex-direction: row;
    align-items: center;
    height: 80px;
    margin: 10px 0;
    padding: 15px 20px;
    background-color: rgba(50, 60, 80, 0.6);
    border-width: 2px;
    border-radius: 12px;
    border-color: rgba(100, 150, 255, 0.3);
    transition-duration: 0.2s;
    transition-property: scale, background-color;
}

.answer-button:hover {
    scale: 1.02;
    background-color: rgba(70, 80, 100, 0.7);
    border-color: rgba(100, 150, 255, 0.5);
}

.answer-button:active {
    scale: 0.98;
}

.answer-button.selected {
    background-color: rgba(100, 150, 255, 0.5);
    border-color: rgb(100, 150, 255);
    border-width: 3px;
}

.answer-button.correct {
    background-color: rgba(100, 255, 100, 0.3);
    border-color: rgb(100, 255, 100);
}

.answer-button.incorrect {
    background-color: rgba(255, 100, 100, 0.3);
    border-color: rgb(255, 100, 100);
}

.answer-letter {
    width: 50px;
    height: 50px;
    background-color: rgba(100, 150, 255, 0.4);
    border-radius: 25px;
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 20px;
    flex-shrink: 0;
}

.answer-button.selected .answer-letter {
    background-color: rgb(100, 150, 255);
}

.answer-text {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    flex-grow: 1;
    white-space: normal;
}

/* Footer Navigation */
.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: rgba(30, 35, 45, 0.9);
    border-top-width: 3px;
    border-color: rgba(100, 150, 255, 0.5);
}

.footer-center {
    flex-direction: column;
    align-items: center;
}

.nav-button {
    min-width: 180px;
    height: 60px;
    font-size: 20px;
}

.skip-button {
    padding: 8px 20px;
    background-color: rgba(80, 80, 100, 0.5);
    border-width: 2px;
    border-radius: 8px;
    border-color: rgba(120, 120, 150, 0.4);
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    margin-bottom: 8px;
}

.skip-button:hover {
    background-color: rgba(100, 100, 120, 0.6);
}

.unanswered-label {
    font-size: 14px;
    color: rgba(255, 200, 100, 0.8);
    -unity-text-align: middle-center;
}

/* Submit Panel */
.submit-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 25, 35, 0.95);
    justify-content: center;
    align-items: center;
    padding: 40px;
}

.submit-warning {
    font-size: 36px;
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.submit-warning-text {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 40px;
    -unity-text-align: middle-center;
}

.submit-buttons {
    flex-direction: row;
    justify-content: center;
}

.submit-buttons .button {
    min-width: 220px;
    height: 70px;
    font-size: 22px;
    margin: 0 15px;
}
