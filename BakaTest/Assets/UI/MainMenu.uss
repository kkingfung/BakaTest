/* Root Container - Portrait Mobile 1080x1920 */
.root {
    flex-grow: 1;
    background-color: rgb(30, 30, 40);
    padding-top: 80px;
    padding-left: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    align-items: stretch;
    justify-content: flex-start;
}

/* Title Panel */
.title-panel {
    align-items: center;
    margin-bottom: 50px;
}

.title {
    font-size: 56px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.subtitle {
    font-size: 28px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Player Info Panel */
.player-info-panel {
    width: 100%;
    background-color: rgb(45, 45, 60);
    border-radius: 15px;
    padding: 30px;
    margin-bottom: 40px;
    border-width: 2px;
    border-color: rgb(100, 100, 120);
}

.section-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 25px;
    -unity-text-align: middle-center;
}

/* Points Container - Vertical Layout for Portrait */
.points-container {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 20px;
}

.points-column {
    flex-direction: column;
    width: 100%;
}

.points-label {
    font-size: 28px;
    color: rgb(100, 200, 255);
    margin: 10px 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Other Info Container - Vertical for Portrait */
.other-info-container {
    flex-direction: column;
    align-items: stretch;
    margin-top: 20px;
    padding-top: 20px;
    border-top-width: 2px;
    border-top-color: rgb(100, 100, 120);
}

.info-label {
    font-size: 26px;
    color: rgb(255, 215, 0);
    margin: 8px 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Menu Buttons Panel - Full Width for Portrait */
.menu-buttons-panel {
    width: 100%;
    align-items: stretch;
    margin-bottom: 40px;
}

.menu-button {
    width: 100%;
    height: 90px;
    font-size: 32px;
    margin: 12px 0;
    background-color: rgb(70, 130, 200);
    color: rgb(255, 255, 255);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(100, 160, 230);
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.menu-button:hover {
    background-color: rgb(90, 150, 220);
    border-color: rgb(120, 180, 250);
    scale: 1.02;
}

.menu-button:active {
    background-color: rgb(50, 110, 180);
    scale: 0.98;
}

/* Footer Panel */
.footer-panel {
    width: 100%;
    align-items: stretch;
    margin-top: auto;
}

.exit-button {
    width: 100%;
    height: 85px;
    font-size: 28px;
    background-color: rgb(150, 50, 50);
    color: rgb(255, 255, 255);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(180, 70, 70);
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.exit-button:hover {
    background-color: rgb(180, 70, 70);
    border-color: rgb(200, 90, 90);
    scale: 1.02;
}

.exit-button:active {
    background-color: rgb(120, 40, 40);
    scale: 0.98;
}
