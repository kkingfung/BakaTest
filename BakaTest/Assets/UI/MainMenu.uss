/*
==============================================
Main Menu Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
    justify-content: flex-start;
}

/* Title Panel */
.title-panel {
    align-items: center;
    margin-bottom: 24px;
    padding: 16px;
}

.title {
    font-size: 48px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.subtitle {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Player Info Panel */
.player-info-panel {
    margin-bottom: 24px;
    padding: 24px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.section-title {
    font-size: 24px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

/* Points Container */
.points-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 16px;
}

.points-column {
    flex-direction: column;
    width: 48%;
    margin-bottom: 8px;
}

.points-label {
    font-size: 18px;
    color: rgb(120, 200, 255);
    margin: 4px 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 12px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 8px;
}

/* Other Info Container */
.other-info-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 2px;
    border-top-color: rgba(100, 150, 255, 0.3);
}

.info-label {
    font-size: 18px;
    color: rgb(255, 220, 100);
    margin: 4px;
    padding: 8px 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 8px;
}

/* Menu Buttons Panel */
.menu-buttons-panel {
    align-items: stretch;
    margin-bottom: 24px;
}

.menu-button {
    min-height: 56px;
    font-size: 20px;
    margin: 8px 0;
    -unity-font-style: bold;
}

/* Footer Panel */
.footer-panel {
    align-items: stretch;
    margin-top: auto;
}

.exit-button {
    min-height: 56px;
    font-size: 20px;
    -unity-font-style: bold;
}
