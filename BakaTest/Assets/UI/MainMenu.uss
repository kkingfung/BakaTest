/* Root Container */
.root {
    flex-grow: 1;
    background-color: rgb(30, 30, 40);
    padding: 40px;
    align-items: center;
    justify-content: space-between;
}

/* Title Panel */
.title-panel {
    align-items: center;
    margin-bottom: 40px;
}

.title {
    font-size: 48px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.subtitle {
    font-size: 24px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
}

/* Player Info Panel */
.player-info-panel {
    width: 600px;
    background-color: rgb(45, 45, 60);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 30px;
    border-width: 2px;
    border-color: rgb(100, 100, 120);
}

.section-title {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
}

/* Points Container */
.points-container {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 15px;
}

.points-column {
    flex-direction: column;
}

.points-label {
    font-size: 18px;
    color: rgb(100, 200, 255);
    margin: 5px 20px;
    -unity-font-style: bold;
}

/* Other Info Container */
.other-info-container {
    flex-direction: row;
    justify-content: space-around;
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(100, 100, 120);
}

.info-label {
    font-size: 16px;
    color: rgb(255, 215, 0);
    margin: 5px 20px;
    -unity-font-style: bold;
}

/* Menu Buttons Panel */
.menu-buttons-panel {
    width: 400px;
    align-items: center;
}

.menu-button {
    width: 100%;
    height: 60px;
    font-size: 20px;
    margin: 10px 0;
    background-color: rgb(70, 130, 200);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 160, 230);
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.menu-button:hover {
    background-color: rgb(90, 150, 220);
    border-color: rgb(120, 180, 250);
    scale: 1.05;
}

.menu-button:active {
    background-color: rgb(50, 110, 180);
    scale: 0.98;
}

/* Footer Panel */
.footer-panel {
    width: 100%;
    align-items: center;
    margin-top: 20px;
}

.exit-button {
    width: 250px;
    height: 50px;
    font-size: 18px;
    background-color: rgb(150, 50, 50);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(180, 70, 70);
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.exit-button:hover {
    background-color: rgb(180, 70, 70);
    border-color: rgb(200, 90, 90);
    scale: 1.05;
}

.exit-button:active {
    background-color: rgb(120, 40, 40);
    scale: 0.98;
}
