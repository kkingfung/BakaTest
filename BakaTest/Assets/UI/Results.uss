/*
==============================================
Results Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
    align-items: stretch;
}

/* Header */
.header {
    align-items: center;
    margin-bottom: 20px;
    padding: 20px;
}

.title {
    font-size: 36px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

/* Victory/Defeat Indicators */
.victory-indicator {
    padding: 20px;
    background-color: rgba(80, 180, 100, 0.3);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgba(100, 220, 120, 0.6);
}

.victory-text {
    font-size: 28px;
    color: rgb(255, 255, 150);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.defeat-indicator {
    padding: 20px;
    background-color: rgba(180, 80, 80, 0.3);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgba(220, 100, 100, 0.6);
}

.defeat-text {
    font-size: 28px;
    color: rgb(255, 200, 200);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Summary Section */
.summary-section {
    align-items: center;
    margin-bottom: 20px;
    padding: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
}

.summary-text {
    font-size: 20px;
    color: rgb(200, 220, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Result Section */
.result-section {
    margin-bottom: 20px;
    padding: 24px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
}

.test-result-section {
    border-color: rgba(100, 170, 255, 0.6);
}

.battle-result-section {
    border-color: rgba(255, 130, 120, 0.6);
}

.section-title {
    font-size: 24px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 16px;
    padding: 12px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
    -unity-text-align: middle-center;
}

/* Result Grid */
.result-grid {
    padding: 12px 0;
}

.result-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 14px 20px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 8px;
}

.result-label {
    font-size: 18px;
    color: rgb(200, 200, 220);
    min-width: 140px;
    -unity-font-style: bold;
}

.result-value {
    font-size: 20px;
    -unity-font-style: bold;
    flex-grow: 1;
    -unity-text-align: middle-right;
}

/* Result Value Colors */
.subject-value { color: rgb(120, 200, 255); }
.difficulty-value { color: rgb(255, 200, 120); }
.score-value { color: rgb(255, 255, 255); }
.accuracy-value { color: rgb(150, 255, 180); }
.points-value { color: rgb(255, 220, 100); font-size: 24px; }
.time-value { color: rgb(180, 200, 255); }
.winner-value { color: rgb(150, 255, 180); font-size: 22px; }
.loser-value { color: rgb(255, 180, 180); font-size: 22px; }
.turn-value { color: rgb(180, 200, 255); }
.duration-value { color: rgb(180, 200, 255); }
.coins-value { color: rgb(255, 220, 100); font-size: 24px; }

/* Warning Label */
.warning-label {
    margin-top: 16px;
    padding: 16px;
    font-size: 16px;
    color: rgb(255, 200, 120);
    background-color: rgba(180, 120, 50, 0.2);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 180, 80, 0.5);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Action Section */
.action-section {
    flex-direction: row;
    justify-content: space-between;
    padding: 12px 0;
    margin-top: 16px;
}

.action-button {
    flex-grow: 1;
    margin: 0 8px;
    min-height: 56px;
}

.continue-button {
    max-width: 35%;
}

.play-again-button {
    max-width: 35%;
}

.menu-button {
    max-width: 25%;
}
