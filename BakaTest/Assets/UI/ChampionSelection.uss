/* Root Container */
.root {
    flex-grow: 1;
    background-color: rgb(20, 20, 30);
    padding: 15px;
}

/* Header */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding: 15px;
    background-color: rgb(30, 30, 45);
    border-radius: 8px;
}

.title {
    font-size: 32px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
}

.coins-label {
    font-size: 24px;
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
}

/* Filter Section */
.filter-section {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 20px;
    padding: 10px;
    background-color: rgb(25, 25, 40);
    border-radius: 8px;
}

.filter-button {
    width: 23%;
    height: 40px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgb(60, 60, 80);
    border-color: rgb(80, 80, 100);
    border-width: 2px;
    border-radius: 5px;
    color: rgb(200, 200, 220);
}

.filter-button:hover {
    background-color: rgb(80, 80, 100);
}

.filter-button.active {
    background-color: rgb(100, 150, 200);
    border-color: rgb(120, 170, 220);
    color: rgb(255, 255, 255);
}

/* Content Section */
.content-section {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 15px;
}

/* List Panel (Left) */
.list-panel {
    width: 30%;
    margin-right: 15px;
    padding: 15px;
    background-color: rgb(25, 25, 40);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(80, 80, 120);
}

.panel-title {
    font-size: 20px;
    color: rgb(200, 200, 255);
    -unity-font-style: bold;
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgb(40, 40, 60);
    border-radius: 5px;
    -unity-text-align: middle-center;
}

.champion-list-scroll {
    flex-grow: 1;
}

.champion-list-container {
    flex-grow: 1;
}

.champion-list-item {
    height: 45px;
    margin-bottom: 8px;
    padding: 10px;
    font-size: 16px;
    background-color: rgb(40, 40, 60);
    border-color: rgb(60, 60, 80);
    border-width: 2px;
    border-radius: 5px;
    color: rgb(200, 200, 220);
    -unity-text-align: middle-left;
}

.champion-list-item:hover {
    background-color: rgb(60, 60, 80);
}

.champion-list-item.selected {
    background-color: rgb(80, 120, 180);
    border-color: rgb(100, 140, 200);
    color: rgb(255, 255, 255);
}

/* Details Panel (Right) */
.details-panel {
    width: 68%;
    padding: 20px;
    background-color: rgb(25, 25, 40);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(80, 80, 120);
}

/* Champion Header */
.champion-header {
    margin-bottom: 15px;
    padding: 15px;
    background-color: rgb(35, 35, 50);
    border-radius: 8px;
}

.champion-name {
    font-size: 28px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.champion-meta {
    flex-direction: row;
    justify-content: space-around;
}

.champion-role {
    font-size: 18px;
    color: rgb(150, 200, 255);
}

.champion-element {
    font-size: 18px;
    color: rgb(255, 150, 150);
}

/* Status Indicators */
.status-indicators {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 15px;
}

.owned-indicator,
.free-indicator,
.locked-indicator {
    padding: 8px 15px;
    margin: 0 5px;
    border-radius: 5px;
    border-width: 2px;
}

.owned-indicator {
    background-color: rgb(50, 120, 50);
    border-color: rgb(100, 200, 100);
}

.free-indicator {
    background-color: rgb(120, 100, 50);
    border-color: rgb(200, 180, 100);
}

.locked-indicator {
    background-color: rgb(100, 50, 50);
    border-color: rgb(180, 100, 100);
}

.status-text {
    font-size: 16px;
    -unity-font-style: bold;
}

.owned-text {
    color: rgb(200, 255, 200);
}

.free-text {
    color: rgb(255, 255, 150);
}

.locked-text {
    color: rgb(255, 200, 200);
}

/* Description Section */
.description-section {
    margin-bottom: 15px;
    padding: 12px;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
}

.champion-description {
    font-size: 16px;
    color: rgb(200, 200, 220);
    white-space: normal;
}

/* Stats Section */
.stats-section {
    margin-bottom: 15px;
    padding: 12px;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
}

.section-title {
    font-size: 18px;
    color: rgb(200, 220, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.stat-label {
    width: 45%;
    font-size: 18px;
    -unity-font-style: bold;
    margin: 5px;
    padding: 8px;
    background-color: rgb(40, 40, 60);
    border-radius: 5px;
    -unity-text-align: middle-center;
}

.hp-stat {
    color: rgb(100, 255, 100);
}

.atk-stat {
    color: rgb(255, 100, 100);
}

.def-stat {
    color: rgb(100, 150, 255);
}

.spd-stat {
    color: rgb(255, 255, 100);
}

/* Affinity Section */
.affinity-section {
    margin-bottom: 15px;
    padding: 12px;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
}

.affinity-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.affinity-label {
    width: 45%;
    font-size: 16px;
    -unity-font-style: bold;
    margin: 5px;
    padding: 8px;
    background-color: rgb(40, 40, 60);
    border-radius: 5px;
    -unity-text-align: middle-center;
}

.math-affinity {
    color: rgb(255, 150, 150);
}

.science-affinity {
    color: rgb(150, 150, 255);
}

.english-affinity {
    color: rgb(255, 255, 150);
}

.history-affinity {
    color: rgb(150, 255, 150);
}

/* Unlock Section */
.unlock-section {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    background-color: rgb(40, 40, 60);
    border-radius: 8px;
}

.unlock-cost {
    font-size: 20px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
}

.unlock-button {
    width: 200px;
    height: 50px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(80, 180, 80);
    border-color: rgb(60, 140, 60);
    border-width: 3px;
    border-radius: 8px;
    color: rgb(255, 255, 255);
}

.unlock-button:hover {
    background-color: rgb(100, 200, 100);
    scale: 1.05;
}

.unlock-button:active {
    scale: 0.95;
}

.unlock-button:disabled {
    background-color: rgb(60, 60, 60);
    border-color: rgb(40, 40, 40);
    color: rgb(120, 120, 120);
}

/* Footer */
.footer {
    flex-direction: row;
    justify-content: center;
    padding: 10px;
}

.back-button {
    width: 200px;
    height: 50px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(120, 120, 140);
    border-color: rgb(100, 100, 120);
    border-width: 3px;
    border-radius: 8px;
    color: rgb(255, 255, 255);
}

.back-button:hover {
    background-color: rgb(140, 140, 160);
    scale: 1.05;
}

.back-button:active {
    scale: 0.95;
}
