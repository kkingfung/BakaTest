/*
==============================================
Champion Selection Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override for this screen */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
}

/* Header Section */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    margin-bottom: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.title {
    font-size: 32px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
}

.coins-label {
    font-size: 20px;
    color: rgb(100, 255, 150);
    -unity-font-style: bold;
}

/* Filter Section */
.filter-section {
    margin-bottom: 16px;
}

.filter-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.filter-button {
    width: 48%;
    min-height: 48px;
    margin-bottom: 8px;
}

/* Content Section - Two Column Layout */
.content-section {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 16px;
}

/* Champion List Panel - Left Side */
.list-panel {
    width: 35%;
    margin-right: 2%;
    padding: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.panel-title {
    font-size: 22px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(100, 150, 255, 0.3);
    -unity-text-align: middle-center;
}

.champion-list-scroll {
    flex-grow: 1;
}

.champion-list-container {
    flex-grow: 1;
}

/* Champion Details Panel - Right Side */
.details-panel {
    width: 63%;
    padding: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

/* Champion Header */
.champion-header {
    margin-bottom: 16px;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.champion-name {
    font-size: 28px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.champion-meta {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.champion-role {
    font-size: 18px;
    color: rgb(120, 200, 255);
    -unity-font-style: bold;
    margin-right: 16px;
}

.champion-element {
    font-size: 18px;
    color: rgb(255, 180, 120);
    -unity-font-style: bold;
}

/* Status Indicators */
.status-indicators {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}

.owned-indicator,
.free-indicator,
.locked-indicator {
    padding: 8px 16px;
    margin: 0 4px;
    border-radius: 8px;
    border-width: 2px;
}

.owned-indicator {
    background-color: rgba(80, 180, 100, 0.3);
    border-color: rgba(100, 220, 120, 0.5);
}

.free-indicator {
    background-color: rgba(180, 150, 80, 0.3);
    border-color: rgba(220, 190, 100, 0.5);
}

.locked-indicator {
    background-color: rgba(180, 80, 80, 0.3);
    border-color: rgba(220, 100, 100, 0.5);
}

.status-text {
    font-size: 16px;
    -unity-font-style: bold;
}

.owned-text {
    color: rgb(150, 255, 180);
}

.free-text {
    color: rgb(255, 240, 150);
}

.locked-text {
    color: rgb(255, 180, 180);
}

/* Description */
.description-section {
    margin-bottom: 16px;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.5);
    border-radius: 10px;
    min-height: 80px;
}

.champion-description {
    font-size: 16px;
    color: rgb(220, 220, 240);
    white-space: normal;
}

/* Stats Grid */
.stats-section {
    margin-bottom: 16px;
}

.section-title {
    font-size: 20px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-label {
    width: 48%;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    padding: 12px;
    background-color: rgba(50, 60, 80, 0.6);
    border-radius: 8px;
    -unity-text-align: middle-center;
}

.hp-stat { color: rgb(150, 255, 150); }
.atk-stat { color: rgb(255, 150, 150); }
.def-stat { color: rgb(150, 200, 255); }
.spd-stat { color: rgb(255, 255, 150); }

/* Affinity Section */
.affinity-section {
    margin-bottom: 16px;
}

.affinity-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.affinity-label {
    width: 48%;
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(50, 60, 80, 0.6);
    border-radius: 8px;
    -unity-text-align: middle-center;
}

.math-affinity { color: rgb(255, 180, 180); }
.science-affinity { color: rgb(180, 180, 255); }
.english-affinity { color: rgb(255, 255, 180); }
.history-affinity { color: rgb(180, 255, 180); }

/* Unlock Section */
.unlock-section {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.unlock-cost {
    font-size: 22px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-right: 16px;
}

.unlock-button {
    flex-grow: 1;
    min-height: 56px;
    max-width: 60%;
}

/* Footer */
.footer {
    flex-direction: row;
    justify-content: center;
    padding: 12px 0;
}

.back-button {
    min-width: 200px;
    min-height: 56px;
}
