/* Champion Selection Screen Styles */

/* Root */
.root {
    background-color: rgba(20, 25, 35, 1);
    padding: 20px 3%;
}

/* Header */
.header {
    align-items: center;
    margin-bottom: 20px;
}

.title-label {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: upper-center;
}

.subtitle-label {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.7);
    -unity-text-align: upper-center;
}

/* Main Content - Two Column Layout */
.main-content {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 15px;
}

/* Left Panel - Champion List */
.left-panel {
    width: 40%;
    padding-right: 15px;
}

/* Filter Panel */
.filter-panel {
    flex-direction: row;
    margin-bottom: 15px;
    justify-content: space-around;
}

.filter-button {
    width: 30%;
    height: 40px;
    font-size: 16px;
    background-color: rgba(50, 60, 80, 0.7);
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.2);
    border-radius: 8px;
}

.filter-button:hover {
    background-color: rgba(60, 70, 90, 0.9);
    border-color: rgba(100, 150, 255, 0.4);
}

.filter-button.selected {
    background-color: rgba(100, 150, 255, 0.5);
    border-color: rgb(100, 150, 255);
    border-width: 3px;
}

/* Champion List Scroll */
.champion-list-scroll {
    flex-grow: 1;
    background-color: rgba(30, 40, 60, 0.4);
    border-radius: 12px;
    padding: 10px;
}

/* Champion Card */
.champion-card {
    background-color: rgba(40, 50, 70, 0.8);
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.2);
    transition-duration: 0.2s;
}

.champion-card:hover {
    background-color: rgba(50, 60, 80, 0.9);
    border-color: rgba(100, 150, 255, 0.4);
    scale: 1.02;
}

.champion-card.selected {
    background-color: rgba(100, 150, 255, 0.4);
    border-color: rgb(100, 150, 255);
    border-width: 3px;
}

.champion-portrait {
    width: 60px;
    height: 60px;
    background-color: rgba(60, 70, 90, 0.8);
    border-radius: 30px;
    border-width: 2px;
    border-color: rgb(100, 150, 255);
    margin-right: 12px;
    align-items: center;
    justify-content: center;
}

.portrait-placeholder {
    font-size: 28px;
    color: rgba(200, 210, 220, 0.5);
    -unity-text-align: middle-center;
}

.champion-card-name {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    flex-grow: 1;
}

.champion-card-role {
    font-size: 14px;
    color: rgba(200, 210, 220, 0.7);
    margin-right: 10px;
}

.champion-card-status {
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 4px;
    -unity-font-style: bold;
}

.champion-card-status.owned {
    background-color: rgba(100, 255, 150, 0.3);
    color: rgb(100, 255, 150);
}

.champion-card-status.free {
    background-color: rgba(100, 200, 255, 0.3);
    color: rgb(100, 200, 255);
}

/* Right Panel - Champion Details */
.right-panel {
    width: 60%;
    padding-left: 15px;
}

/* Champion Header */
.champion-header {
    background-color: rgba(40, 50, 70, 0.7);
    border-radius: 15px;
    padding: 20px;
    margin-bottom: 15px;
    flex-direction: row;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.champion-portrait-large {
    width: 120px;
    height: 120px;
    background-color: rgba(60, 70, 90, 0.8);
    border-radius: 60px;
    border-width: 3px;
    border-color: rgb(100, 150, 255);
    margin-right: 20px;
    align-items: center;
    justify-content: center;
}

.portrait-placeholder-large {
    font-size: 56px;
    color: rgba(200, 210, 220, 0.5);
    -unity-text-align: middle-center;
}

.champion-info {
    flex-grow: 1;
    justify-content: center;
}

.champion-name-label {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.champion-tags {
    flex-direction: row;
}

.tag-label {
    font-size: 14px;
    padding: 5px 12px;
    border-radius: 6px;
    margin-right: 8px;
    -unity-font-style: bold;
}

.role-tag {
    background-color: rgba(255, 150, 100, 0.3);
    color: rgb(255, 150, 100);
}

.element-tag {
    background-color: rgba(100, 200, 255, 0.3);
    color: rgb(100, 200, 255);
}

/* Stats Panel */
.stats-panel {
    background-color: rgba(40, 50, 70, 0.7);
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 15px;
}

.panel-subtitle {
    font-size: 18px;
    color: rgba(200, 210, 220, 0.9);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: upper-center;
}

/* Stat Bars */
.stat-bars {
    margin-bottom: 15px;
}

.stat-bar-container {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.stat-bar-label {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.9);
    min-width: 50px;
    -unity-font-style: bold;
}

.stat-bar-bg {
    flex-grow: 1;
    height: 20px;
    background-color: rgba(30, 40, 60, 0.8);
    border-radius: 10px;
    margin: 0 10px;
    overflow: hidden;
}

.stat-bar-fill {
    height: 100%;
    border-radius: 10px;
    transition-duration: 0.3s;
}

.hp-bar {
    background-color: rgb(100, 255, 150);
}

.attack-bar {
    background-color: rgb(255, 150, 100);
}

.defense-bar {
    background-color: rgb(100, 200, 255);
}

.speed-bar {
    background-color: rgb(255, 200, 100);
}

.stat-bar-value {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    min-width: 60px;
    -unity-text-align: middle-right;
}

/* Additional Stats */
.additional-stats {
    flex-direction: row;
    justify-content: space-around;
    padding: 10px 0;
    border-top-width: 1px;
    border-top-color: rgba(100, 150, 255, 0.2);
}

.stat-item {
    flex-direction: row;
}

.stat-item-label {
    font-size: 14px;
    color: rgba(200, 210, 220, 0.7);
    margin-right: 8px;
}

.stat-item-value {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* Abilities Panel */
.abilities-panel {
    background-color: rgba(40, 50, 70, 0.7);
    border-radius: 12px;
    padding: 15px;
    flex-grow: 1;
}

.abilities-scroll {
    flex-grow: 1;
}

.ability-placeholder {
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.placeholder-text {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.5);
    -unity-text-align: middle-center;
}

.ability-item {
    background-color: rgba(50, 60, 80, 0.6);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(100, 150, 255, 0.2);
}

.ability-name {
    font-size: 16px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.ability-description {
    font-size: 14px;
    color: rgba(200, 210, 220, 0.8);
    white-space: normal;
}

/* Action Panel */
.action-panel {
    flex-direction: row;
    justify-content: space-around;
    padding: 15px 0;
}

.select-button {
    width: 50%;
    height: 70px;
    font-size: 24px;
}

.secondary-button {
    width: 35%;
    height: 60px;
    font-size: 18px;
    background-color: rgba(60, 70, 90, 0.8);
}

.secondary-button:hover {
    background-color: rgba(70, 80, 100, 0.9);
}

/* Responsive adjustments */
@media (max-width: 1000px) {
    .main-content {
        flex-direction: column;
    }
    
    .left-panel,
    .right-panel {
        width: 100%;
        padding: 0;
        margin-bottom: 20px;
    }
    
    .champion-list-scroll {
        max-height: 300px;
    }
}
