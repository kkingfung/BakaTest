/*
==============================================
Battle Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    background-color: rgb(235, 240, 245);
    padding: 2%;
}

/* Header */
.header {
    margin-bottom: 16px;
    align-items: center;
}

.title {
    font-size: 32px;
    color: rgb(40, 50, 70);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.status-label {
    font-size: 18px;
    color: rgb(66, 133, 244);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

/* Battle Arena */
.battle-arena {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 16px;
    padding: 20px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(200, 200, 200, 0.6);
}

.player-section {
    width: 100%;
    margin-bottom: 12px;
}

.player-name {
    font-size: 20px;
    color: rgb(40, 50, 70);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.champion-card {
    padding: 20px;
    background-color: rgb(250, 250, 250);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(220, 220, 220, 0.8);
    align-items: center;
}

.champion-portrait {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgb(200, 200, 200);
    margin-bottom: 12px;
    justify-content: center;
    align-items: center;
}

.portrait-placeholder {
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.champion-name {
    font-size: 20px;
    color: rgb(66, 133, 244);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.stats-section {
    width: 100%;
}

.hp-label {
    font-size: 18px;
    color: rgb(52, 168, 83);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.hp-bar {
    width: 100%;
    height: 24px;
    margin-top: 4px;
}

/* VS Section */
.vs-section {
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 12px 0;
}

.vs-label {
    font-size: 48px;
    color: rgb(234, 67, 53);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Player Specific Styles */
.player1 .champion-card {
    border-color: rgba(66, 133, 244, 0.6);
}

.player2 .champion-card {
    border-color: rgba(234, 67, 53, 0.6);
}

/* Battle Log */
.log-section {
    margin-bottom: 16px;
    padding: 20px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(200, 200, 200, 0.6);
    min-height: 150px;
    max-height: 200px;
}

.log-title {
    font-size: 20px;
    color: rgb(40, 50, 70);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.log-scroll {
    flex-grow: 1;
    background-color: rgb(250, 250, 250);
    border-radius: 8px;
    padding: 12px;
}

.log-text {
    font-size: 16px;
    color: rgb(40, 50, 70);
    white-space: pre-wrap;
}

/* Controls Section */
.controls-section {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.control-button {
    width: 48%;
    min-height: 56px;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 0;
    margin-bottom: 8px;
}

.start-button {
    background-color: rgb(52, 168, 83);
    color: rgb(255, 255, 255);
}

.start-button:hover {
    background-color: rgb(46, 150, 74);
    scale: 1.02;
}

.start-button:disabled {
    opacity: 0.3;
}

.item-button {
    background-color: rgb(251, 188, 5);
    color: rgb(255, 255, 255);
}

.item-button:hover {
    background-color: rgb(225, 168, 4);
    scale: 1.02;
}

.item-button:disabled {
    opacity: 0.3;
}

.abort-button {
    background-color: rgb(150, 150, 150);
    color: rgb(255, 255, 255);
}

.abort-button:hover {
    background-color: rgb(234, 67, 53);
    scale: 1.02;
}

.abort-button:disabled {
    opacity: 0.3;
}

.results-button {
    background-color: rgb(66, 133, 244);
    color: rgb(255, 255, 255);
}

.results-button:hover {
    background-color: rgb(57, 116, 213);
    scale: 1.02;
}

.results-button:disabled {
    opacity: 0.3;
}
