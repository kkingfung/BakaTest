/* Root Container - Portrait Mobile 1080x1920 */
.root {
    flex-grow: 1;
    background-color: rgb(245, 245, 245);
    padding-top: 60px;
    padding-left: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
}

/* Header */
.header {
    margin-bottom: 30px;
    align-items: center;
}

.title {
    font-size: 48px;
    color: rgb(33, 33, 33);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.status-label {
    font-size: 24px;
    color: rgb(66, 133, 244);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* Battle Arena - Vertical Stack for Portrait */
.battle-arena {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 25px;
    padding: 30px;
    background-color: rgb(255, 255, 255);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(200, 200, 200);
}

.player-section {
    width: 100%;
    margin-bottom: 20px;
}

.player-name {
    font-size: 28px;
    color: rgb(33, 33, 33);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 15px;
}

.champion-card {
    padding: 25px;
    background-color: rgb(250, 250, 250);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(220, 220, 220);
    align-items: center;
}

.champion-portrait {
    width: 150px;
    height: 150px;
    border-radius: 75px;
    background-color: rgb(200, 200, 200);
    margin-bottom: 15px;
    justify-content: center;
    align-items: center;
}

.portrait-placeholder {
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.champion-name {
    font-size: 26px;
    color: rgb(66, 133, 244);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.stats-section {
    width: 100%;
}

.hp-label {
    font-size: 24px;
    color: rgb(52, 168, 83);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.hp-bar {
    width: 100%;
    height: 35px;
    margin-top: 5px;
}

/* VS Section */
.vs-section {
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 20px 0;
}

.vs-label {
    font-size: 64px;
    color: rgb(234, 67, 53);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Player Specific Styles */
.player1 .champion-card {
    border-color: rgb(66, 133, 244);
}

.player2 .champion-card {
    border-color: rgb(234, 67, 53);
}

/* Battle Log */
.log-section {
    margin-bottom: 25px;
    padding: 25px;
    background-color: rgb(255, 255, 255);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(200, 200, 200);
    min-height: 200px;
    max-height: 300px;
}

.log-title {
    font-size: 26px;
    color: rgb(33, 33, 33);
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.log-scroll {
    flex-grow: 1;
    background-color: rgb(250, 250, 250);
    border-radius: 10px;
    padding: 15px;
}

.log-text {
    font-size: 20px;
    color: rgb(33, 33, 33);
    white-space: pre-wrap;
}

/* Controls - 2x2 Grid for Portrait */
.controls-section {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.control-button {
    width: 48%;
    height: 85px;
    font-size: 24px;
    -unity-font-style: bold;
    border-radius: 15px;
    border-width: 0;
    margin-bottom: 15px;
}

.start-button {
    background-color: rgb(52, 168, 83);
    color: rgb(255, 255, 255);
}

.start-button:hover {
    background-color: rgb(46, 150, 74);
    scale: 1.02;
}

.start-button:disabled {
    opacity: 0.3;
}

.item-button {
    background-color: rgb(251, 188, 5);
    color: rgb(255, 255, 255);
}

.item-button:hover {
    background-color: rgb(225, 168, 4);
    scale: 1.02;
}

.item-button:disabled {
    opacity: 0.3;
}

.abort-button {
    background-color: rgb(150, 150, 150);
    color: rgb(255, 255, 255);
}

.abort-button:hover {
    background-color: rgb(234, 67, 53);
    scale: 1.02;
}

.abort-button:disabled {
    opacity: 0.3;
}

.results-button {
    background-color: rgb(66, 133, 244);
    color: rgb(255, 255, 255);
}

.results-button:hover {
    background-color: rgb(57, 116, 213);
    scale: 1.02;
}

.results-button:disabled {
    opacity: 0.3;
}
