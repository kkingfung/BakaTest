/*
==============================================
Test Selection Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
}

/* Header Panel */
.header-panel {
    align-items: center;
    margin-bottom: 24px;
    padding: 16px;
}

.title {
    font-size: 36px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Selection Panel */
.selection-panel {
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

/* Control Container */
.control-container {
    flex-direction: column;
    align-items: stretch;
    margin: 16px 0;
}

.control-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-left;
}

.dropdown {
    min-height: 48px;
    font-size: 18px;
    background-color: rgba(55, 65, 85, 0.8);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.4);
    padding-left: 12px;
    padding-right: 12px;
}

/* Points Info Panel */
.points-info-panel {
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.section-title {
    font-size: 24px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.points-stats-container {
    flex-direction: column;
    align-items: stretch;
}

.points-stat-label {
    font-size: 18px;
    margin: 8px 0;
    padding: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 8px;
}

.points-stat-label.remaining {
    color: rgb(150, 255, 180);
    font-size: 22px;
}

.points-stat-label.earned {
    color: rgb(120, 200, 255);
}

.points-stat-label.cap {
    color: rgb(200, 200, 220);
}

.note-label {
    font-size: 16px;
    color: rgb(180, 180, 200);
    -unity-text-align: middle-center;
    margin-top: 12px;
    -unity-font-style: italic;
    white-space: normal;
}

/* Action Panel */
.action-panel {
    flex-direction: column;
    align-items: stretch;
    margin-top: auto;
    padding-top: 12px;
}

.start-button {
    min-height: 60px;
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.back-button {
    min-height: 56px;
    font-size: 20px;
    -unity-font-style: bold;
}
