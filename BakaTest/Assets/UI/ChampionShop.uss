/* Root Container */
.root {
    flex-grow: 1;
    background-color: rgb(30, 30, 40);
    padding: 20px;
    justify-content: space-between;
}

/* Title Panel */
.title-panel {
    align-items: center;
    margin-bottom: 20px;
}

.title {
    font-size: 40px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.subtitle {
    font-size: 20px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
}

/* Player Info Panel */
.player-info-panel {
    align-items: center;
    margin-bottom: 15px;
}

.coins-label {
    font-size: 24px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
}

/* Main Content */
.main-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 500px;
}

/* Champion List Panel */
.champion-list-panel {
    width: 35%;
    background-color: rgb(45, 45, 60);
    border-radius: 10px;
    padding: 15px;
    margin-right: 20px;
    border-width: 2px;
    border-color: rgb(100, 100, 120);
}

/* Filter Buttons */
.filter-buttons-panel {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 15px;
}

.filter-button {
    flex-grow: 1;
    margin: 0 5px;
    padding: 8px;
    background-color: rgb(60, 60, 80);
    border-color: rgb(100, 100, 120);
    border-width: 1px;
    border-radius: 5px;
    color: rgb(220, 220, 220);
    font-size: 14px;
}

.filter-button:hover {
    background-color: rgb(80, 80, 100);
}

.filter-button.selected {
    background-color: rgb(100, 150, 255);
    border-color: rgb(150, 200, 255);
}

/* Champion List Scroll */
.champion-list-scroll {
    flex-grow: 1;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
    padding: 10px;
}

.placeholder-text {
    color: rgb(150, 150, 150);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-top: 50px;
}

/* Champion Details Panel */
.champion-details-panel {
    width: 65%;
    background-color: rgb(45, 45, 60);
    border-radius: 10px;
    padding: 20px;
    border-width: 2px;
    border-color: rgb(100, 100, 120);
}

/* Champion Basic Info */
.champion-basic-info {
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(100, 100, 120);
}

.champion-name {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.champion-meta-info {
    flex-direction: row;
    margin-bottom: 10px;
}

.meta-label {
    font-size: 16px;
    color: rgb(150, 200, 255);
    margin-right: 20px;
}

.champion-description {
    font-size: 14px;
    color: rgb(200, 200, 200);
    white-space: normal;
    margin-top: 10px;
}

/* Champion Stats Panel */
.champion-stats-panel {
    margin-bottom: 20px;
    padding: 15px;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
}

.section-title {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.stats-grid {
    flex-direction: column;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 10px;
    margin: 2px 0;
}

.stat-label {
    font-size: 16px;
    color: rgb(180, 180, 200);
    flex-grow: 1;
}

.stat-value {
    font-size: 16px;
    color: rgb(100, 255, 150);
    -unity-font-style: bold;
    min-width: 80px;
    -unity-text-align: middle-right;
}

/* Purchase Info */
.champion-purchase-info {
    margin-bottom: 15px;
    padding: 10px;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
}

.price-label {
    font-size: 20px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.owned-label {
    font-size: 16px;
    color: rgb(150, 255, 150);
    margin-bottom: 3px;
}

.free-rotation-label {
    font-size: 14px;
    color: rgb(100, 200, 255);
}

/* Purchase Button */
.purchase-button {
    width: 100%;
    height: 50px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(50, 150, 50);
    border-color: rgb(80, 200, 80);
    border-width: 2px;
    border-radius: 8px;
    color: rgb(255, 255, 255);
}

.purchase-button:hover {
    background-color: rgb(70, 180, 70);
}

.purchase-button:disabled {
    background-color: rgb(80, 80, 80);
    border-color: rgb(100, 100, 100);
    color: rgb(150, 150, 150);
}

/* Footer Panel */
.footer-panel {
    align-items: center;
    margin-top: 15px;
}

.back-button {
    width: 200px;
    height: 40px;
    font-size: 18px;
    background-color: rgb(60, 60, 80);
    border-color: rgb(100, 100, 120);
    border-width: 2px;
    border-radius: 5px;
    color: rgb(220, 220, 220);
}

.back-button:hover {
    background-color: rgb(80, 80, 100);
}
