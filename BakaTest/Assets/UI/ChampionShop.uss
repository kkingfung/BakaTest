/*
==============================================
Champion Shop Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
}

/* Header */
.title-panel {
    align-items: center;
    margin-bottom: 16px;
    padding: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
}

.title {
    font-size: 36px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
}

/* Player Info */
.player-info-panel {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
    padding: 12px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 10px;
}

.coins-label {
    font-size: 24px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
}

/* Main Content - Side by Side */
.main-content {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 16px;
}

/* Champion List - Left Side */
.champion-list-panel {
    width: 35%;
    margin-right: 2%;
    padding: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.filter-buttons-panel {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 12px;
}

.filter-button {
    width: 48%;
    margin-bottom: 8px;
}

.champion-list-scroll {
    flex-grow: 1;
}

.placeholder-text {
    color: rgba(200, 200, 220, 0.6);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-top: 60px;
}

/* Champion Details - Right Side */
.champion-details-panel {
    width: 63%;
    padding: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.champion-basic-info {
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(100, 150, 255, 0.3);
}

.champion-name {
    font-size: 28px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.champion-meta-info {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}

.meta-label {
    font-size: 16px;
    color: rgb(120, 200, 255);
    -unity-font-style: bold;
    margin: 0 8px;
}

.champion-description {
    font-size: 16px;
    color: rgb(220, 220, 240);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Stats Panel */
.champion-stats-panel {
    margin-bottom: 16px;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.section-title {
    font-size: 20px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.stats-grid {
    flex-direction: column;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    margin-bottom: 6px;
    background-color: rgba(50, 60, 80, 0.6);
    border-radius: 8px;
}

.stat-label {
    font-size: 16px;
    color: rgb(200, 200, 220);
    flex-grow: 1;
}

.stat-value {
    font-size: 18px;
    color: rgb(150, 255, 180);
    -unity-font-style: bold;
    min-width: 80px;
    -unity-text-align: middle-right;
}

/* Purchase Info */
.champion-purchase-info {
    margin-bottom: 12px;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.price-label {
    font-size: 22px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.owned-label {
    font-size: 18px;
    color: rgb(150, 255, 180);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.free-rotation-label {
    font-size: 16px;
    color: rgb(120, 200, 255);
    -unity-text-align: middle-center;
}

.purchase-button {
    min-height: 56px;
    font-size: 20px;
}

/* Footer */
.footer-panel {
    flex-direction: row;
    justify-content: center;
    padding: 12px 0;
}

.back-button {
    min-width: 200px;
    min-height: 56px;
}
