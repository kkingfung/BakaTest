/* Root Container */
.root {
    flex-grow: 1;
    background-color: rgb(20, 20, 30);
    padding: 20px;
}

/* Header */
.header {
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    padding: 15px;
    background-color: rgb(30, 30, 45);
    border-radius: 8px;
}

.title {
    font-size: 32px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Section Title */
.section-title {
    font-size: 22px;
    color: rgb(200, 200, 255);
    -unity-font-style: bold;
    margin-bottom: 15px;
    padding: 8px;
    background-color: rgb(40, 40, 60);
    border-radius: 5px;
}

/* Champion Section */
.champion-section {
    margin-bottom: 25px;
    padding: 15px;
    background-color: rgb(25, 25, 40);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(80, 80, 120);
}

.champion-dropdown {
    height: 40px;
    margin-bottom: 15px;
    background-color: rgb(40, 40, 60);
    border-width: 2px;
    border-color: rgb(100, 100, 150);
    border-radius: 5px;
    color: rgb(255, 255, 255);
    font-size: 18px;
}

.champion-info {
    padding: 10px;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
}

.champion-name {
    font-size: 24px;
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.champion-details {
    flex-direction: row;
    justify-content: space-around;
}

.champion-detail {
    font-size: 16px;
    color: rgb(180, 180, 220);
}

/* Allocation Section */
.allocation-section {
    margin-bottom: 25px;
    padding: 15px;
    background-color: rgb(25, 25, 40);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(80, 80, 120);
}

.subject-control {
    margin-bottom: 20px;
    padding: 12px;
    background-color: rgb(35, 35, 50);
    border-radius: 5px;
}

.subject-label {
    font-size: 18px;
    color: rgb(200, 220, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.slider-container {
    flex-direction: column;
}

.subject-slider {
    height: 30px;
    margin-bottom: 8px;
}

.subject-slider .unity-base-slider__dragger {
    background-color: rgb(100, 150, 255);
    border-radius: 50%;
    width: 20px;
    height: 20px;
}

.subject-slider .unity-base-slider__tracker {
    background-color: rgb(60, 60, 80);
    border-radius: 5px;
    height: 8px;
}

.subject-slider .unity-base-slider__drag-container {
    background-color: rgb(80, 120, 200);
    border-radius: 5px;
    height: 8px;
}

.point-labels {
    flex-direction: row;
    justify-content: space-between;
}

.allocated-label {
    font-size: 20px;
    color: rgb(100, 255, 100);
    -unity-font-style: bold;
}

.remaining-label {
    font-size: 16px;
    color: rgb(255, 255, 150);
}

/* Stats Section */
.stats-section {
    margin-bottom: 25px;
    padding: 15px;
    background-color: rgb(25, 25, 40);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(120, 80, 80);
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
    padding: 10px;
}

.stat-label {
    width: 45%;
    font-size: 20px;
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
    margin: 5px;
    padding: 10px;
    background-color: rgb(40, 40, 60);
    border-radius: 5px;
    -unity-text-align: middle-center;
}

/* Action Section */
.action-section {
    flex-direction: row;
    justify-content: space-around;
    padding: 10px;
}

.action-button {
    width: 30%;
    height: 50px;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 2px;
    transition-duration: 0.2s;
}

.action-button:hover {
    scale: 1.05;
}

.action-button:active {
    scale: 0.95;
}

.reset-button {
    background-color: rgb(120, 120, 140);
    border-color: rgb(100, 100, 120);
    color: rgb(255, 255, 255);
}

.reset-button:hover {
    background-color: rgb(140, 140, 160);
}

.start-button {
    background-color: rgb(80, 180, 80);
    border-color: rgb(60, 140, 60);
    color: rgb(255, 255, 255);
}

.start-button:hover {
    background-color: rgb(100, 200, 100);
}

.start-button:disabled {
    background-color: rgb(60, 60, 60);
    border-color: rgb(40, 40, 40);
    color: rgb(120, 120, 120);
}

.back-button {
    background-color: rgb(180, 80, 80);
    border-color: rgb(140, 60, 60);
    color: rgb(255, 255, 255);
}

.back-button:hover {
    background-color: rgb(200, 100, 100);
}
