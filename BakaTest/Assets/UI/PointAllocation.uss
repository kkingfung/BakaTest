/*
==============================================
Point Allocation Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
}

/* Header */
.header {
    align-items: center;
    margin-bottom: 16px;
    padding: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
}

.title {
    font-size: 36px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
}

/* Section Title */
.section-title {
    font-size: 22px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    padding: 12px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
    -unity-text-align: middle-center;
}

/* Champion Section */
.champion-section {
    margin-bottom: 20px;
    padding: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.champion-dropdown {
    min-height: 56px;
    margin-bottom: 16px;
}

.champion-info {
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.champion-name {
    font-size: 24px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.champion-details {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.champion-detail {
    font-size: 16px;
    color: rgb(150, 200, 255);
    margin: 4px 12px;
    -unity-font-style: bold;
}

/* Allocation Section */
.allocation-section {
    margin-bottom: 20px;
    padding: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.subject-control {
    margin-bottom: 20px;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.subject-label {
    font-size: 20px;
    color: rgb(150, 200, 255);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.slider-container {
    flex-direction: column;
}

.subject-slider {
    min-height: 32px;
    margin-bottom: 8px;
}

.point-labels {
    flex-direction: row;
    justify-content: space-between;
    padding: 0 4px;
}

.allocated-label {
    font-size: 20px;
    color: rgb(150, 255, 180);
    -unity-font-style: bold;
}

.remaining-label {
    font-size: 18px;
    color: rgb(255, 255, 180);
}

/* Stats Section */
.stats-section {
    margin-bottom: 20px;
    padding: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 12px;
}

.stat-label {
    width: 48%;
    font-size: 18px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 12px;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
    -unity-text-align: middle-center;
}

/* Action Section */
.action-section {
    flex-direction: row;
    justify-content: space-between;
    padding: 12px 0;
}

.action-button {
    flex-grow: 1;
    margin: 0 8px;
    min-height: 56px;
}

.reset-button {
    max-width: 30%;
}

.start-button {
    max-width: 40%;
}

.back-button {
    max-width: 25%;
}
