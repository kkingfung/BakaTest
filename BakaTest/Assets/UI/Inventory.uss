/*
==============================================
Inventory Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
}

/* Header */
.title-panel {
    align-items: center;
    margin-bottom: 16px;
    padding: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
}

.title {
    font-size: 36px;
    color: rgb(150, 255, 180);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
}

/* Player Info */
.player-info-panel {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
    padding: 12px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 10px;
}

.coins-label {
    font-size: 22px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-right: 24px;
}

.items-label {
    font-size: 20px;
    color: rgb(150, 255, 200);
    -unity-font-style: bold;
}

/* Main Content */
.main-content {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 16px;
}

/* Item List - Left Side */
.item-list-panel {
    width: 35%;
    margin-right: 2%;
    padding: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.filter-buttons-panel {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 12px;
}

.filter-button {
    width: 30%;
    margin-bottom: 8px;
    font-size: 15px;
}

.item-list-scroll {
    flex-grow: 1;
}

.placeholder-text {
    color: rgba(200, 200, 220, 0.6);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-top: 80px;
}

/* Item Details - Right Side */
.item-details-panel {
    width: 63%;
    padding: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.item-basic-info {
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(100, 150, 255, 0.3);
}

.item-name {
    font-size: 28px;
    color: rgb(150, 255, 180);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.item-meta-info {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}

.meta-label {
    font-size: 16px;
    color: rgb(120, 200, 255);
    -unity-font-style: bold;
    margin: 0 8px;
}

.item-description {
    font-size: 16px;
    color: rgb(220, 220, 240);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Sell Info */
.item-sell-info {
    margin-bottom: 12px;
    padding: 16px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.sell-price-label {
    font-size: 22px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sell-button {
    min-height: 56px;
    font-size: 20px;
}

/* Footer */
.footer-panel {
    flex-direction: row;
    justify-content: center;
    padding: 12px 0;
}

.back-button {
    min-width: 200px;
    min-height: 56px;
}
