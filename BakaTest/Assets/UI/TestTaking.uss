/*
==============================================
Test Taking Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    background-color: rgb(235, 240, 245);
    padding: 2%;
}

/* Header Section */
.header {
    margin-bottom: 16px;
    align-items: center;
}

.title {
    font-size: 32px;
    color: rgb(40, 50, 70);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

/* Test Info */
.test-info {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.subject-label {
    font-size: 20px;
    color: rgb(66, 133, 244);
    -unity-font-style: bold;
    margin: 0 8px;
}

.difficulty-label {
    font-size: 18px;
    color: rgb(100, 100, 100);
    margin: 0 8px;
}

/* Timer Section */
.timer-section {
    margin-bottom: 16px;
    padding: 20px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(66, 133, 244, 0.3);
    align-items: center;
}

.timer-label {
    font-size: 36px;
    color: rgb(52, 168, 83);
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.timer-label.warning {
    color: rgb(251, 188, 5);
}

.timer-label.critical {
    color: rgb(234, 67, 53);
}

.timer-progress {
    width: 100%;
    height: 24px;
}

/* Progress Section */
.progress-section {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
    padding: 16px;
    background-color: rgb(255, 255, 255);
    border-radius: 10px;
}

.question-counter {
    font-size: 20px;
    color: rgb(66, 133, 244);
    -unity-font-style: bold;
    margin: 0 12px;
}

.answered-count {
    font-size: 18px;
    color: rgb(100, 100, 100);
    margin: 0 12px;
}

/* Question Section */
.question-section {
    margin-bottom: 16px;
    padding: 24px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(66, 133, 244);
    min-height: 120px;
}

.question-text {
    font-size: 20px;
    color: rgb(33, 33, 33);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Choices Section */
.choices-section {
    margin-bottom: 16px;
}

.choice-button {
    margin-bottom: 12px;
    padding: 16px;
    font-size: 18px;
    background-color: rgb(255, 255, 255);
    color: rgb(33, 33, 33);
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    border-radius: 10px;
    -unity-text-align: middle-left;
    white-space: normal;
    height: auto;
    min-height: 56px;
}

.choice-button:hover {
    background-color: rgb(232, 240, 254);
    border-color: rgb(66, 133, 244);
}

.choice-button.selected {
    background-color: rgb(66, 133, 244);
    color: rgb(255, 255, 255);
    border-color: rgb(66, 133, 244);
    -unity-font-style: bold;
}

.choice-button:disabled {
    opacity: 0.5;
}

/* Navigation Section */
.navigation-section {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 16px;
}

.nav-button {
    flex-grow: 1;
    margin: 0 4px;
    min-height: 48px;
    font-size: 18px;
    background-color: rgb(255, 255, 255);
    color: rgb(66, 133, 244);
    border-width: 2px;
    border-color: rgb(66, 133, 244);
    border-radius: 10px;
}

.nav-button:hover {
    background-color: rgb(66, 133, 244);
    color: rgb(255, 255, 255);
}

.nav-button:disabled {
    opacity: 0.3;
    border-color: rgb(200, 200, 200);
    color: rgb(150, 150, 150);
}

/* Action Section */
.action-section {
    flex-direction: row;
    justify-content: space-between;
}

.submit-button {
    flex-grow: 1;
    margin: 0 4px;
    min-height: 56px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(52, 168, 83);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 10px;
}

.submit-button:hover {
    background-color: rgb(46, 150, 74);
}

.submit-button:active {
    background-color: rgb(40, 132, 65);
    scale: 0.98;
}

.back-button {
    flex-grow: 1;
    margin: 0 4px;
    min-height: 56px;
    font-size: 18px;
    background-color: rgb(255, 255, 255);
    color: rgb(150, 150, 150);
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    border-radius: 10px;
}

.back-button:hover {
    background-color: rgb(234, 67, 53);
    color: rgb(255, 255, 255);
    border-color: rgb(234, 67, 53);
}

.back-button:active {
    background-color: rgb(210, 60, 48);
    scale: 0.98;
}
