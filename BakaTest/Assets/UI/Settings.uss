/*
==============================================
Settings Screen - Responsive Design
==============================================
*/

/* Import global theme */
@import url("Common/GlobalTheme.uss");

/* Root override */
.root {
    flex-grow: 1;
    padding: 2%;
    background-color: rgb(25, 30, 40);
}

/* Header */
.title-panel {
    align-items: center;
    margin-bottom: 20px;
    padding: 16px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
}

.title {
    font-size: 36px;
    color: rgb(180, 180, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
}

/* Settings Scroll Container */
.settings-scroll {
    flex-grow: 1;
    margin-bottom: 16px;
}

/* Settings Panel */
.settings-panel {
    padding: 20px;
    margin-bottom: 20px;
    background-color: rgba(45, 55, 75, 0.7);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.panel-title {
    font-size: 24px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(100, 150, 255, 0.3);
}

/* Setting Row */
.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    margin-bottom: 12px;
    background-color: rgba(55, 65, 85, 0.6);
    border-radius: 10px;
}

.setting-label {
    font-size: 18px;
    color: rgb(220, 220, 240);
    -unity-font-style: bold;
    flex-grow: 1;
    min-width: 40%;
}

/* Control Container */
.control-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    max-width: 55%;
}

/* Sliders */
.volume-slider,
.speed-slider {
    flex-grow: 1;
    margin-right: 12px;
}

.value-label {
    font-size: 18px;
    color: rgb(150, 255, 180);
    -unity-font-style: bold;
    min-width: 60px;
    -unity-text-align: middle-right;
}

/* Toggle */
.setting-toggle .unity-toggle__checkmark {
    background-color: rgba(50, 60, 80, 0.9);
    border-color: rgba(100, 150, 255, 0.4);
    border-width: 2px;
    border-radius: 6px;
    width: 40px;
    height: 40px;
}

.setting-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(80, 180, 100, 0.9);
    border-color: rgba(100, 220, 120, 0.6);
}

/* Language Dropdown */
.language-dropdown {
    flex-grow: 1;
}

/* Action Buttons */
.action-buttons-panel {
    flex-direction: row;
    justify-content: space-between;
    padding: 12px 0;
}

.action-button {
    flex-grow: 1;
    margin: 0 8px;
    min-height: 56px;
}

.reset-button {
    max-width: 30%;
}

.save-button {
    max-width: 35%;
}

.cancel-button {
    max-width: 30%;
}
