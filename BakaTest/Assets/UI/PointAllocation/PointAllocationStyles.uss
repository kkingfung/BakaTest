/* Point Allocation Screen Styles */

/* Root */
.root {
    background-color: rgba(20, 25, 35, 1);
    flex-grow: 1;
}

.root > .unity-scroll-view__content-container {
    padding: 2%;
    flex-grow: 1;
}

/* Header */
.header {
    align-items: center;
    margin-bottom: 15px;
}

.title-label {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 5px;
    -unity-text-align: upper-center;
}

.subtitle-label {
    font-size: 14px;
    color: rgba(200, 210, 220, 0.7);
    -unity-text-align: upper-center;
}

/* Main Content - Two Column Layout */
.main-content {
    flex-direction: row;
    margin-bottom: 10px;
}

/* Left Panel - Available Points */
.left-panel {
    width: 50%;
    padding-right: 1%;
    flex-shrink: 0;
}

.panel-title {
    font-size: 20px;
    color: rgb(200, 210, 220);
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: upper-center;
}

/* Subject Panels */
.subject-panel {
    background-color: rgba(40, 50, 70, 0.7);
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 8px;
    border-width: 2px;
}

.math-panel {
    border-color: rgba(255, 150, 100, 0.4);
}

.science-panel {
    border-color: rgba(100, 200, 255, 0.4);
}

.english-panel {
    border-color: rgba(150, 255, 150, 0.4);
}

.history-panel {
    border-color: rgba(255, 200, 100, 0.4);
}

.subject-label {
    font-size: 20px;
    color: rgb(200, 210, 220);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.points-available-label {
    font-size: 18px;
    color: rgb(100, 200, 255);
    margin-bottom: 10px;
}

.points-available-label::before {
    content: "Available: ";
    color: rgba(200, 210, 220, 0.7);
}

/* Allocation Control */
.allocation-control {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.allocation-slider {
    flex-grow: 1;
    margin-right: 15px;
}

.allocation-slider .unity-base-slider__dragger {
    width: 20px;
    height: 20px;
    background-color: rgb(100, 150, 255);
    border-radius: 10px;
}

.allocation-slider .unity-base-slider__tracker {
    height: 8px;
    background-color: rgba(60, 70, 90, 0.8);
    border-radius: 4px;
}

.allocation-slider .unity-base-slider__drag-container {
    height: 8px;
    background-color: rgb(100, 150, 255);
    border-radius: 4px;
}

.points-allocated-label {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    min-width: 60px;
    -unity-text-align: middle-right;
}

.stat-preview-label {
    font-size: 14px;
    color: rgb(100, 255, 150);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* Total Panel */
.total-panel {
    background-color: rgba(60, 70, 90, 0.8);
    border-radius: 12px;
    padding: 15px;
    margin-top: 10px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.total-label {
    font-size: 18px;
    color: rgba(200, 210, 220, 0.9);
}

.total-value-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* Right Panel - Champion Preview */
.right-panel {
    width: 50%;
    padding-left: 1%;
    flex-shrink: 0;
}

/* Champion Info */
.champion-info-panel {
    background-color: rgba(40, 50, 70, 0.7);
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 10px;
    align-items: center;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
}

.champion-portrait {
    width: 80px;
    height: 80px;
    background-color: rgba(60, 70, 90, 0.8);
    border-radius: 40px;
    border-width: 2px;
    border-color: rgb(100, 150, 255);
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.portrait-placeholder {
    font-size: 32px;
    color: rgba(200, 210, 220, 0.5);
    -unity-text-align: middle-center;
}

.champion-name-label {
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.champion-role-label {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.7);
}

/* Stats Panel */
.stats-panel {
    background-color: rgba(40, 50, 70, 0.7);
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 10px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 150, 255, 0.2);
}

.stat-row:last-child {
    border-bottom-width: 0;
}

.stat-name-label {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.9);
    min-width: 80px;
}

.stat-base-label {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.7);
    min-width: 50px;
    -unity-text-align: middle-right;
}

.stat-arrow {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.5);
    margin: 0 10px;
}

.stat-final-label {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    min-width: 60px;
    -unity-text-align: middle-right;
}

.stat-bonus-label {
    font-size: 14px;
    color: rgb(100, 255, 150);
    margin-left: 10px;
}

/* Affinity Panel */
.affinity-panel {
    background-color: rgba(40, 50, 70, 0.7);
    border-radius: 12px;
    padding: 10px;
}

.affinity-title {
    font-size: 16px;
    color: rgba(200, 210, 220, 0.9);
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: upper-center;
}

.affinity-label {
    font-size: 14px;
    color: rgba(200, 210, 220, 0.7);
    margin-bottom: 5px;
}

/* Action Panel */
.action-panel {
    flex-direction: row;
    justify-content: space-around;
    padding: 10px 0;
    margin-top: 10px;
}

.confirm-button {
    width: 40%;
    height: 50px;
    font-size: 20px;
}

.secondary-button {
    width: 25%;
    height: 50px;
    font-size: 16px;
    background-color: rgba(60, 70, 90, 0.8);
}

.secondary-button:hover {
    background-color: rgba(70, 80, 100, 0.9);
}

/* Responsive adjustments */
@media (max-width: 1000px) {
    .main-content {
        flex-direction: column;
    }
    
    .left-panel,
    .right-panel {
        width: 100%;
        padding: 0;
        margin-bottom: 20px;
    }
    
    .action-panel {
        flex-direction: column;
        align-items: stretch;
    }
    
    .confirm-button,
    .secondary-button {
        width: 100%;
        margin-bottom: 10px;
    }
}
