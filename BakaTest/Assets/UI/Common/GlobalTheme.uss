/* BakaTest Global Theme - Common UI Styles */

/* Root and Base Styles */
.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(20, 25, 35);
}

/* Container Styles */
.main-container {
    width: 90%;
    max-width: 1200px;
    padding: 30px;
    background-color: rgba(30, 35, 45, 0.95);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.5);
}

.content-area {
    flex-grow: 1;
    padding: 20px;
}

/* Typography */
.title-label {
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.subtitle-label {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.section-title {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 15px;
    margin-top: 20px;
}

.label {
    font-size: 18px;
    color: rgb(255, 255, 255);
}

/* Button Styles */
.button {
    height: 60px;
    font-size: 20px;
    background-color: rgba(50, 60, 80, 0.8);
    border-width: 2px;
    border-radius: 10px;
    border-color: rgba(100, 150, 255, 0.3);
    color: rgb(255, 255, 255);
    margin: 8px;
    transition-duration: 0.2s;
    transition-property: scale, background-color;
}

.button:hover {
    scale: 1.05;
    background-color: rgba(70, 80, 100, 0.9);
    border-color: rgba(100, 150, 255, 0.6);
}

.button:active {
    scale: 0.98;
    background-color: rgba(40, 50, 70, 0.9);
}

.button:disabled {
    background-color: rgba(30, 35, 40, 0.5);
    border-color: rgba(80, 80, 80, 0.3);
    color: rgba(255, 255, 255, 0.3);
}

/* Primary Button */
.primary-button {
    background-color: rgba(100, 200, 100, 0.7);
    border-color: rgba(100, 255, 100, 0.6);
}

.primary-button:hover {
    scale: 1.02;
    background-color: rgba(120, 220, 120, 0.8);
    border-color: rgba(100, 255, 100, 0.8);
}

.primary-button:active {
    scale: 0.98;
    background-color: rgba(80, 180, 80, 0.8);
}

/* Secondary Button */
.secondary-button {
    background-color: rgba(80, 80, 100, 0.6);
    border-color: rgba(120, 120, 150, 0.5);
}

.secondary-button:hover {
    background-color: rgba(100, 100, 120, 0.7);
}

/* Danger Button */
.danger-button {
    background-color: rgba(200, 80, 80, 0.7);
    border-color: rgba(255, 100, 100, 0.6);
}

.danger-button:hover {
    background-color: rgba(220, 100, 100, 0.8);
}

/* Selected State */
.selected {
    background-color: rgba(100, 150, 255, 0.7);
    border-color: rgb(100, 150, 255);
    border-width: 3px;
}

/* Panel Styles */
.panel {
    padding: 20px;
    background-color: rgba(40, 50, 70, 0.6);
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
    margin: 10px 0;
}

.info-panel {
    padding: 25px;
    background-color: rgba(40, 50, 70, 0.6);
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.4);
    margin: 20px 0;
}

/* Warning Panel */
.warning-panel {
    padding: 20px;
    background-color: rgba(255, 150, 50, 0.2);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 150, 50, 0.6);
    margin: 15px 0;
}

.warning-text {
    font-size: 20px;
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.warning-subtext {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
}

/* Input Fields */
.text-field {
    height: 40px;
    font-size: 18px;
    background-color: rgba(30, 35, 45, 0.8);
    border-width: 2px;
    border-radius: 8px;
    border-color: rgba(100, 150, 255, 0.3);
    color: rgb(255, 255, 255);
    padding: 5px 10px;
}

.text-field:focus {
    border-color: rgba(100, 150, 255, 0.8);
}

/* Progress Bar */
.progress-bar {
    height: 30px;
    background-color: rgba(30, 35, 45, 0.8);
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.3);
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: rgb(100, 150, 255);
    border-radius: 15px;
    transition-duration: 0.3s;
    transition-property: width;
}

/* Utility Classes */
.flex-row {
    flex-direction: row;
}

.flex-column {
    flex-direction: column;
}

.justify-center {
    justify-content: center;
}

.align-center {
    align-items: center;
}

.space-between {
    justify-content: space-between;
}

.flex-grow {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.visible {
    display: flex;
}
